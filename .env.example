# Bridge authentication
BRIDGE_MCP_TOKEN="bridge-mcp-secret-token"
# Dedicated token for Bridge Local Executor PC workers. Prefer a different secret from BRIDGE_MCP_TOKEN.
BRIDGE_EXECUTOR_TOKEN="bridge-executor-secret-token"
APP_URL="MY_APP_URL"

# Project
PROJECT_NAME="BridgeChatgpt"
PROJECT_ROOT="."
DEFAULT_BRANCH="main"
REPOSITORY_URL="https://github.com/machxanht/BridgeChatgpt"

# Bridge Local Executor server-side persistence/leases.
BRIDGE_EXECUTOR_STORE_PATH="data/executors.json"
BRIDGE_EXECUTOR_ONLINE_WINDOW_MS="35000"
BRIDGE_EXECUTOR_RUNNING_LEASE_MS="1800000"

# GitHub Command Bus. Remote polling lets Bridge see commands written by ChatGPT
# without requiring Google AI Studio to Pull the repository first. This repository is
# public, so read-only polling does not require a GitHub credential.
GITHUB_COMMAND_BUS_ENABLED="true"
GITHUB_COMMAND_BUS_REMOTE_ENABLED="true"
GITHUB_COMMAND_BUS_REPOSITORY="machxanht/BridgeChatgpt"
GITHUB_COMMAND_BUS_BRANCH="main"
GITHUB_COMMAND_BUS_POLL_MS="5000"
GITHUB_COMMAND_BUS_REMOTE_POLL_MS="60000"

# Display labels only. Do NOT put passwords, cookies, access tokens, or other secrets here.
CHATGPT_ACCOUNT_LABEL="ChatGPT Plus - my account"
GEMINI_ACCOUNT_LABEL="Google AI Studio - my account"
HUMAN_ACCOUNT_LABEL="Operator"

# External Google AI Studio execution mode.
# Bridge itself does NOT call Gemini API in this mode. Studio talks to the authenticated
# REST relay at /api/studio-relay (state, heartbeat, claim, progress, result, message).
GEMINI_EXTERNAL_AGENT_ENABLED="true"

# Optional Bridge-side Gemini API worker. Leave false/empty when the goal is to use
# the interactive Google AI Studio executor/quota instead of Bridge calling Gemini API.
GEMINI_WORKER_ENABLED="false"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_WORKER_INTERVAL_MS="5000"
