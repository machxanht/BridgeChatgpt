# Bridge authentication
BRIDGE_MCP_TOKEN="bridge-mcp-secret-token"
APP_URL="MY_APP_URL"

# Project
PROJECT_NAME="BridgeChatgpt"
PROJECT_ROOT="."
DEFAULT_BRANCH="main"
REPOSITORY_URL="https://github.com/machxanht/BridgeChatgpt"

# Display labels only. Do NOT put passwords, cookies, access tokens, or other secrets here.
CHATGPT_ACCOUNT_LABEL="ChatGPT Plus - my account"
GEMINI_ACCOUNT_LABEL="Google AI Studio - my account"
HUMAN_ACCOUNT_LABEL="Operator"

# External Google AI Studio execution mode.
# Bridge itself does NOT call Gemini API in this mode. Studio talks to the authenticated
# REST relay at /api/studio-relay (state, heartbeat, claim, progress, result, message).
GEMINI_EXTERNAL_AGENT_ENABLED="true"

# Optional Bridge-side Gemini API worker. Leave false/empty when the goal is to use
# the interactive Google AI Studio executor/quota instead of Bridge calling Gemini API.
GEMINI_WORKER_ENABLED="false"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_WORKER_INTERVAL_MS="5000"
