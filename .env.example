# Bridge authentication
BRIDGE_MCP_TOKEN="bridge-mcp-secret-token"
APP_URL="MY_APP_URL"

# Project
PROJECT_NAME="BridgeChatgpt"
PROJECT_ROOT="."
DEFAULT_BRANCH="main"
REPOSITORY_URL="https://github.com/machxanht/BridgeChatgpt"

# Display labels only. Do NOT put passwords, cookies, access tokens, or other secrets here.
# Bridge cannot safely discover the signed-in ChatGPT/Google email from the provider UI,
# so set a friendly account label if you want Mission Control to distinguish accounts.
CHATGPT_ACCOUNT_LABEL="ChatGPT Plus - my account"
GEMINI_ACCOUNT_LABEL="Google AI Studio - my account"
HUMAN_ACCOUNT_LABEL="Operator"

# Gemini execution mode A (recommended when using Google AI Studio Agents):
# AI Studio Agent connects to Bridge's remote Streamable HTTP MCP endpoint and performs
# the coding loop externally. This mode does NOT require Bridge's local GEMINI_API_KEY worker.
GEMINI_EXTERNAL_AGENT_ENABLED="false"

# Gemini execution mode B (optional Bridge-side Gemini API worker):
# This consumes Gemini API usage and requires an API key. Do not enable it if you intend
# to use only the AI Studio Agent as executor.
GEMINI_WORKER_ENABLED="false"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_WORKER_INTERVAL_MS="5000"
