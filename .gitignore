# Apps is the PC project shelf. Bridge tracks only itself + standards/templates.
# Other Apps/<Project> folders are independent nested repositories and must not
# pollute the BridgeChatgpt working tree.
Apps/*
!Apps/README.md
!Apps/BridgeChatgpt/
!Apps/BridgeChatgpt/**
!Apps/_TEMPLATE/
!Apps/_TEMPLATE/**

# Bridge persisted runtime state
data/*.sqlite
data/batches.json
data/batches.json.*.tmp
data/workspace-registry.json
data/workspace-registry.json.*.tmp
data/resource-registry.json
data/resource-registry.json.*.tmp
data/executors.json
data/executors.json.*.tmp
data/executor-auth.json
data/executor-auth.json.*.tmp
runtime/bridge-bus/outbox/
data/*.sqlite.*
data/runtime-revocations.json*
runtime/runner-control/
runtime/runner-releases/
runtime/agent-runs/
runtime/agent-tasks/
runtime/completion-validation-*/

# Isolated Phase 2 validation copies, logs and local harness artifacts.
runtime/phase2-validation-*/
runtime/phase2-smoke-*/
runtime/phase2-validation-latest.txt
runtime/phase2-validate.mjs
runtime/phase2-smoke.mjs

